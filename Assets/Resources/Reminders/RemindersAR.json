{
  "language": "ar",
  "version": 1,
  "items": [
    { "id": 1, "text": "فعل الخير هو شكل من أشكال الصدقة.", "source": "Reminder" },
    { "id": 2, "text": "الصبر مفتاح الشدة.", "source": "Reminder" },
    { "id": 3, "text": "الكلمات الطيبة تلين القلوب.", "source": "Reminder" },
    { "id": 4, "text": "ذكر الله يريح القلب.", "source": "Reminder" },
    { "id": 5, "text": "الإحسان إلى الجار جزء من الإيمان.", "source": "Reminder" },
    { "id": 6, "text": "خير الناس من ينفع الناس.", "source": "Reminder" },
    { "id": 7, "text": "المسامحة تقوي القلب.", "source": "Reminder" },
    { "id": 8, "text": "الكبر يجعل الإنسان صغيرًا.", "source": "Reminder" },
    { "id": 9, "text": "الشكر يزيد النعم.", "source": "Reminder" },
    { "id": 10, "text": "الصدق يبني الثقة.", "source": "Reminder" },

    { "id": 11, "text": "حسن الخلق أعظم ثروة.", "source": "Reminder" },
    { "id": 12, "text": "كسر القلوب سهل، لكن إصلاحها صعب.", "source": "Reminder" },
    { "id": 13, "text": "الراحمون يرحمهم الرحمن.", "source": "Reminder" },
    { "id": 14, "text": "الأعمال الصالحة تطهر النفس.", "source": "Reminder" },
    { "id": 15, "text": "قول الحق يحتاج إلى شجاعة.", "source": "Reminder" },
    { "id": 16, "text": "الظلم ظلمات.", "source": "Reminder" },
    { "id": 17, "text": "الغيبة تُظلم القلب.", "source": "Reminder" },
    { "id": 18, "text": "الكسب الحلال يجلب البركة.", "source": "Reminder" },
    { "id": 19, "text": "الدعاء قوة المؤمن.", "source": "Reminder" },
    { "id": 20, "text": "رحمة الله واسعة.", "source": "Reminder" },

    { "id": 21, "text": "قلة الكلام حكمة.", "source": "Reminder" },
    { "id": 22, "text": "القلب النقي هو جوهر العبادة.", "source": "Reminder" },
    { "id": 23, "text": "الغنى الحقيقي في القلب لا في المال.", "source": "Reminder" },
    { "id": 24, "text": "كن بنّاءً لا هدامًا.", "source": "Reminder" },
    { "id": 25, "text": "حسن الأدب جمال الإنسان.", "source": "Reminder" },
    { "id": 26, "text": "من يعن أخاه لا يُترك وحده.", "source": "Reminder" },
    { "id": 27, "text": "النية الصادقة تعطي قيمة للأعمال.", "source": "Reminder" },
    { "id": 28, "text": "الغضب نار تحرق الروح.", "source": "Reminder" },
    { "id": 29, "text": "كظم الغيظ فضيلة عظيمة.", "source": "Reminder" },
    { "id": 30, "text": "النية الحسنة تضاعف الخير.", "source": "Reminder" },

    { "id": 31, "text": "الصدق شرف الإنسان.", "source": "Reminder" },
    { "id": 32, "text": "الوفاء بالعهد من الإيمان.", "source": "Reminder" },
    { "id": 33, "text": "لا تحتقرن أحدًا.", "source": "Reminder" },
    { "id": 34, "text": "المتواضع يرفعه الله.", "source": "Reminder" },
    { "id": 35, "text": "حقوق الآخرين مسؤولية كبيرة.", "source": "Reminder" },
    { "id": 36, "text": "القلب المكسور قد يقلل من قيمة العبادة.", "source": "Reminder" },
    { "id": 37, "text": "الإيمان ينمو بالصبر.", "source": "Reminder" },
    { "id": 38, "text": "لا تغتر بالدنيا، واذكر الآخرة.", "source": "Reminder" },
    { "id": 39, "text": "قابل الإساءة بالإحسان.", "source": "Reminder" },
    { "id": 40, "text": "لا تبحث عن عيوب الآخرين، انظر إلى عيوبك.", "source": "Reminder" },

    { "id": 41, "text": "الحسد ينهك القلب.", "source": "Reminder" },
    { "id": 42, "text": "تمنى لغيرك ما تتمنى لنفسك.", "source": "Reminder" },
    { "id": 43, "text": "حسن الخلق من أعظم العبادات.", "source": "Reminder" },
    { "id": 44, "text": "حب الناس من الإيمان.", "source": "Reminder" },
    { "id": 45, "text": "إذا كانت كلماتك مؤذية فالصمت أفضل.", "source": "Reminder" },
    { "id": 46, "text": "دعاء الوالدين نعمة عظيمة.", "source": "Reminder" },
    { "id": 47, "text": "إدخال السرور على اليتيم أجر كبير.", "source": "Reminder" },
    { "id": 48, "text": "نصرة المكروب رحمة.", "source": "Reminder" },
    { "id": 49, "text": "الخير الذي يُعمل لوجه الله لا يضيع.", "source": "Reminder" },
    { "id": 50, "text": "إن مع العسر يسرًا.", "source": "Reminder" },

    { "id": 51, "text": "كسر القلوب أثقل من كسر الحجارة.", "source": "Reminder" },
    { "id": 52, "text": "قيمة الإنسان في تقواه.", "source": "Reminder" },
    { "id": 53, "text": "الأعمال الصغيرة المستمرة أكثر قيمة.", "source": "Reminder" },
    { "id": 54, "text": "الدعاء يبقي الأمل حيًا.", "source": "Reminder" },
    { "id": 55, "text": "لا تستصغر الذنوب، ولا تؤخر التوبة.", "source": "Reminder" },
    { "id": 56, "text": "إذا طاب القلب طاب اللسان.", "source": "Reminder" },
    { "id": 57, "text": "اجتناب الشر عبادة.", "source": "Reminder" },
    { "id": 58, "text": "من توكل على الله لا يضيع.", "source": "Reminder" },
    { "id": 59, "text": "الأمانة أساس العلاقات.", "source": "Reminder" },
    { "id": 60, "text": "اجعل كلماتك شفاءً لا جرحًا.", "source": "Reminder" },

    { "id": 61, "text": "طلب العلم إشعال سراج في الظلام.", "source": "Reminder" },
    { "id": 62, "text": "العبادة ليست فقط صلاة، بل حسن خلق أيضًا.", "source": "Reminder" },
    { "id": 63, "text": "حتى العمل الصغير خير لا يستهان به.", "source": "Reminder" },
    { "id": 64, "text": "الابتسامة صدقة.", "source": "Reminder" },
    { "id": 65, "text": "حفظ الأمانة من الإيمان.", "source": "Reminder" },
    { "id": 66, "text": "الكذب يفسد القلب.", "source": "Reminder" },
    { "id": 67, "text": "البهتان من أثقل الذنوب.", "source": "Reminder" },
    { "id": 68, "text": "باب التوبة مفتوح دائمًا.", "source": "Reminder" },
    { "id": 69, "text": "عدل الله لا يخلف.", "source": "Reminder" },
    { "id": 70, "text": "الإنسان مسؤول عن كلماته.", "source": "Reminder" },

    { "id": 71, "text": "نهاية الصبر سلام.", "source": "Reminder" },
    { "id": 72, "text": "النوايا الحسنة تلين حتى الأمور الصعبة.", "source": "Reminder" },
    { "id": 73, "text": "لا تحقد، أبق قلبك نقيًا.", "source": "Reminder" },
    { "id": 74, "text": "القناعة بما أعطاه الله تريح القلب.", "source": "Reminder" },
    { "id": 75, "text": "الحب لله نعمة عظيمة.", "source": "Reminder" },
    { "id": 76, "text": "فعل الخير بعد الذنب يطهر القلب.", "source": "Reminder" },
    { "id": 77, "text": "المال يكتسب معنى عندما يُشارك.", "source": "Reminder" },
    { "id": 78, "text": "الإسراف يزيل البركة.", "source": "Reminder" },
    { "id": 79, "text": "الكسب الحرام يظلم القلب.", "source": "Reminder" },
    { "id": 80, "text": "حاول أن تحسن نفسك كل يوم.", "source": "Reminder" },

    { "id": 81, "text": "الكبر طريق الشيطان.", "source": "Reminder" },
    { "id": 82, "text": "التواضع جمال المؤمن.", "source": "Reminder" },
    { "id": 83, "text": "إفشاء السلام ينشر المحبة.", "source": "Reminder" },
    { "id": 84, "text": "القلب يطمئن بذكر الله.", "source": "Reminder" },
    { "id": 85, "text": "من عمل صالحًا فلنفسه.", "source": "Reminder" },
    { "id": 86, "text": "لا تظلم، وخف دعوة المظلوم.", "source": "Reminder" },
    { "id": 87, "text": "الظلم يدمر السلام.", "source": "Reminder" },
    { "id": 88, "text": "الكلمة الطيبة أقوى موعظة.", "source": "Reminder" },
    { "id": 89, "text": "الله يحب الإخلاص.", "source": "Reminder" },
    { "id": 90, "text": "لا تكن ثقلاً على الناس، كن سندًا.", "source": "Reminder" },

    { "id": 91, "text": "رحمة الله لا تدع مجالًا لليأس.", "source": "Reminder" },
    { "id": 92, "text": "أبق قلبك نقيًا، تتحسن حياتك.", "source": "Reminder" },
    { "id": 93, "text": "العادات السيئة تضعف الروح.", "source": "Reminder" },
    { "id": 94, "text": "الأعمال الخفية الصالحة أكثر قيمة.", "source": "Reminder" },
    { "id": 95, "text": "تجنب إيذاء الناس.", "source": "Reminder" },
    { "id": 96, "text": "حسن الخلق أقوى دعوة.", "source": "Reminder" },
    { "id": 97, "text": "لا تنس أنك ضيف في هذه الدنيا.", "source": "Reminder" },
    { "id": 98, "text": "كل يوم بداية جديدة.", "source": "Reminder" },
    { "id": 99, "text": "من يتجه إلى الله لا يضيع.", "source": "Reminder" },
    { "id": 100, "text": "التنافس في الخير يجعل الحياة أفضل.", "source": "Reminder" }
  ]
}